{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "allowSyntheticDefaultImports": true,
    "types": ["vite/client", "node"],
    "paths": {
      "@/*": ["./src/*"],
      "@spa/shared-types": ["../../packages/shared-types/src/index.ts"],
      "@spa/ui-kit": ["../../packages/ui-kit/src/index.ts"]
    }
  },
  "include": ["src", "../../packages/shared-types/src", "../../packages/ui-kit/src", "vite.config.ts"]
}
